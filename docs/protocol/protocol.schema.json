{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fältprotokoll – definitionsformat 2.0.0",
  "description": "Kontrollerar den fristående protokollfilen. Inventeringar valideras med response_format.schema i protocol.json samt dess kompletterande regler.",
  "type": "object",
  "required": [
    "definition_format_version",
    "protocol_id",
    "version",
    "name",
    "language",
    "updated_at",
    "description",
    "sections",
    "fields",
    "record_types",
    "response_format",
    "compatibility"
  ],
  "additionalProperties": false,
  "properties": {
    "definition_format_version": {
      "const": "2.0.0"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "record_types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "fields",
          "schema"
        ],
        "properties": {
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/field"
            }
          },
          "schema": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "response_format": {
      "type": "object",
      "required": [
        "format",
        "version",
        "description",
        "rules",
        "schema"
      ],
      "properties": {
        "format": {
          "const": "faltrapport"
        },
        "version": {
          "const": 1
        },
        "description": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "previous_definition",
        "legacy_web_import"
      ],
      "properties": {
        "previous_definition": {
          "type": "string"
        },
        "legacy_web_import": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": [
        "field",
        "equals"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "equals": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "applicable_when": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type",
        "required",
        "storage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "date",
            "integer",
            "decimal",
            "enum",
            "multienum",
            "attachment",
            "records"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "storage": {
          "enum": [
            "fields",
            "images",
            "record"
          ]
        },
        "description": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "applicable_when": {
          "$ref": "#/$defs/condition"
        },
        "record_type": {
          "type": "string"
        },
        "encoding": {
          "const": "json-string-array"
        },
        "max_records": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "enum",
                  "multienum"
                ]
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          },
          "else": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "records"
              }
            }
          },
          "then": {
            "required": [
              "record_type",
              "encoding",
              "max_records"
            ],
            "properties": {
              "storage": {
                "const": "fields"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "attachment"
              }
            }
          },
          "then": {
            "properties": {
              "storage": {
                "const": "images"
              }
            }
          }
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "field_ref"
          ],
          "properties": {
            "field_ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "label",
            "children"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "section",
                "group"
              ]
            },
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
